{#- Before & After gallery. Data: src/_data/projects.json. JS: /assets/js/ba-slider.js -#}
{%- set first = projects.items[0] -%}
<div class="ba-gallery" data-ba-gallery>
  <figure class="ba" data-ba>
    <div class="ba__frame" data-ba-frame>
      <img class="ba__img" data-ba-after src="{{ first.after }}" alt="After: {{ first.title }}" width="1600" height="1000" decoding="async">
      <div class="ba__before" data-ba-before>
        <img class="ba__img" src="{{ first.before }}" alt="Before: {{ first.title }}" width="1600" height="1000" decoding="async">
      </div>
      <span class="ba__tag ba__tag--before" aria-hidden="true">Before</span>
      <span class="ba__tag ba__tag--after" aria-hidden="true">After</span>
      <div class="ba__handle" data-ba-handle role="slider" tabindex="0" aria-label="Before and after comparison. Use arrow keys to reveal." aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50% before">
        <span class="ba__knob" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </div>
      <span class="ba__illustration" data-ba-illustration {% if not first.placeholder %}hidden{% endif %}>Illustration — project photo to follow</span>
    </div>
    <figcaption class="ba__caption" aria-live="polite">
      <span class="ba__type" data-ba-type>{{ first.type }}</span>
      <strong data-ba-title>{{ first.title }}</strong>
      <span data-ba-caption>{{ first.caption }}</span>
    </figcaption>
  </figure>

  <div class="ba-tabs" role="tablist" aria-label="Projects">
    {% for p in projects.items %}
    <button class="ba-tab" type="button" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}"
      data-before="{{ p.before }}" data-after="{{ p.after }}" data-title="{{ p.title }}" data-caption="{{ p.caption }}" data-type="{{ p.type }}" data-placeholder="{{ p.placeholder }}">
      <span class="ba-tab__thumb"><img src="{{ p.after }}" alt="" loading="lazy" width="160" height="100"></span>
      <span class="ba-tab__label"><span class="mono">{{ "0" if loop.index < 10 }}{{ loop.index }}</span> {{ p.title }}</span>
    </button>
    {% endfor %}
  </div>
</div>
