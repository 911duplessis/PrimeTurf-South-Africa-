---
layout: layouts/base.njk
---
<header class="page-hero">
  <div class="wrap">
    {% if breadcrumbs %}
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {% for c in breadcrumbs %}<li>{% if c.href %}<a href="{{ c.href }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}</li>{% endfor %}
      </ol>
    </nav>
    {% endif %}
    {% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1 class="display-l" data-reveal>{{ heading or title }}</h1>
    {% if lede %}<p class="lede" data-reveal>{{ lede }}</p>{% endif %}
  </div>
</header>
{{ content | safe }}
{% include "partials/cta-band.njk" %}
