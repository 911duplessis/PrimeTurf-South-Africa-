---
layout: layouts/base.njk
homepage: true
bodyClass: is-home
faqSchema: true
scripts:
  - /assets/js/ba-slider.js
  - /assets/js/visualiser/visualiser.js
---
{# ───────────────────────── 1. HERO ───────────────────────── #}
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__field" aria-hidden="true">
    <img class="hero__img" src="/assets/img/work/putting-green-completed.webp" alt="" width="1080" height="1080" fetchpriority="high" decoding="async">
    <div class="hero__grid"></div>
  </div>
  <div class="wrap hero__inner">
    <p class="eyebrow eyebrow--gold" data-reveal>Luxury Living · Lifestyle Enhancement</p>
    <h1 id="hero-title" class="display-xl hero__title">
      <span class="line" data-reveal>Always green.</span>
      <span class="line line--muted" data-reveal>Never watered.</span>
    </h1>
    <p class="lede hero__lede" data-reveal>Premium artificial turf, scoped, supplied and installed by our own team — built for Highveld sun, summer storms and coastal air.</p>
    <div class="hero__ctas" data-reveal>
      <a class="btn btn--gold btn--lg" href="#visualise">Visualise your space</a>
      <a class="btn btn--ghost-light btn--lg" href="#quote">Get a free quote</a>
    </div>
    <dl class="spec-card" data-reveal aria-label="Installation specification">
      <div><dt>Irrigation</dt><dd>0 L</dd></div>
      <div><dt>Fibre</dt><dd>UV-stabilised</dd></div>
      <div><dt>Drainage</dt><dd>All-weather</dd></div>
      <div><dt>Warranty</dt><dd>6 yr + 24 mo</dd></div>
    </dl>
  </div>
</section>

{% include "partials/who-we-are.njk" %}

{# ───────────────────────── 2. BENEFITS / SPEC LEDGER ───────────────────────── #}
<section class="section" id="why" aria-labelledby="why-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">Why PrimeTurf Gauteng &amp; Cape Town</p>
      <h2 id="why-title" class="display-l" data-reveal>Five things every installation is built on.</h2>
    </header>
    <ol class="ledger">
      {% for b in benefits %}
      <li class="ledger__row" data-reveal>
        <span class="ledger__num label">0{{ loop.index }}</span>
        <h3 class="ledger__title">{{ b.title }}</h3>
        <p class="ledger__body">{{ b.body }}</p>
        <span class="ledger__label" aria-hidden="true">{{ b.label }}</span>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ───────────────────────── 3. BEFORE & AFTER ───────────────────────── #}
<section class="section section--ink" id="results" aria-labelledby="results-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div>
        <p class="eyebrow eyebrow--gold">Before &amp; after</p>
        <h2 id="results-title" class="display-l" data-reveal>Drag to see the difference.</h2>
      </div>
      <p class="section-head__aside">Real PrimeTurf projects, photographed from the same spot before and after.</p>
    </header>
    {% include "partials/ba-gallery.njk" %}

    <div class="work" aria-labelledby="work-title">
      <header class="work__head">
        <h3 id="work-title" class="work__title">Recent work</h3>
        <p class="work__note">Photos from PrimeTurf installations.</p>
      </header>
      <ul class="work__grid">
        {% for g in gallery %}
        <li class="work__item{% if g.feature %} work__item--feature{% endif %}" data-reveal>
          <figure>
            <img src="{{ g.src }}" alt="{{ g.alt }}" width="{{ g.w }}" height="{{ g.h }}" loading="lazy" decoding="async">
            <figcaption>{{ g.caption }}</figcaption>
          </figure>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ───────────────────────── 4. VISUALISER ───────────────────────── #}
<section class="section section--tint" id="visualise" aria-labelledby="viz-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div>
        <p class="eyebrow">Visualise your project</p>
        <h2 id="viz-title" class="display-l" data-reveal>See a concept of your space — and a price range — in two minutes.</h2>
      </div>
      <p class="section-head__aside">Upload a photo, answer a few quote questions, and get a concept visual with an indicative installed price. A free site visit confirms the details.</p>
    </header>
    {% include "partials/visualiser.njk" %}
  </div>
</section>

{# ───────────────────────── 5. SERVICES ───────────────────────── #}
<section class="section" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div>
        <p class="eyebrow">Services</p>
        <h2 id="services-title" class="display-l" data-reveal>Homes, estates and commercial sites.</h2>
      </div>
      <a class="btn btn--text" href="/services/">All services →</a>
    </header>
    <div class="svc-cols">
      {% set groups = [["residential","Residential","Gardens, pools and putting greens."],["commercial","Commercial","Estates, businesses, schools and sport."],["maintenance","Maintenance","Refresh existing artificial turf."]] %}
      {% for g in groups %}
      <div class="svc-col" data-reveal>
        <p class="svc-col__head"><span class="label">{{ loop.index }}/3</span> {{ g[1] }}</p>
        <p class="svc-col__sub">{{ g[2] }}</p>
        <ul class="svc-list">
          {% for s in services | where("group", g[0]) %}
          <li><a class="svc-link" href="/services/{{ s.slug }}/"><span class="svc-link__title">{{ s.title }}</span><span class="svc-link__sum">{{ s.summary }}</span><span class="svc-link__arrow" aria-hidden="true">→</span></a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
      <aside class="refresh" data-reveal>
      <div>
        <h3 class="refresh__title">Already have artificial turf installed?</h3>
        <p>We also restore and maintain existing installations. Professional cleaning, maintenance and refresh services revive your turf, leaving it clean, vibrant and as good as new.</p>
      </div>
      <a class="btn btn--outline" href="/services/maintenance-refresh/">Maintenance &amp; refresh</a>
    </aside>
  </div>
</section>

{% include "partials/install-types.njk" %}

{# ───────────────────────── 6. PRICING ───────────────────────── #}
<section class="section" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap pricing">
    <div class="pricing__copy">
      <p class="eyebrow">Straight numbers</p>
      <h2 id="pricing-title" class="display-l" data-reveal>R{{ site.pricing.minPerM2 }}–R{{ site.pricing.maxPerM2 }}<span class="unit"> per m²</span></h2>
      <p class="lede">Typical fully installed range. Where your project lands depends on two things:</p>
      <ul class="factor-list">
        <li><strong>Turf grade</strong> — pile, density and intended use.</li>
        <li><strong>Site preparation</strong> — removal, levelling, drainage and access.</li>
      </ul>
      <p class="fine">Indicative only. Your fixed quote follows a free site visit.</p>
    </div>
    <div class="calc" data-quick-calc data-reveal>
      <label class="calc__label" for="calc-m2">Your area</label>
      <output class="calc__m2 display-m" data-calc-m2-out for="calc-m2">50 m²</output>
      <input id="calc-m2" type="range" min="10" max="500" step="5" value="50" class="range range--lg" data-calc-m2>
      <div class="calc__result">
        <span class="label">Indicative installed</span>
        <strong class="calc__total" data-calc-total>R22 500 – R42 500</strong>
      </div>
      <a class="btn btn--primary btn--block" href="#visualise">Get a tailored range →</a>
    </div>
  </div>
</section>

{# ───────────────────────── 7. PROCESS ───────────────────────── #}
<section class="section section--ruled" id="process" aria-labelledby="process-title">
  <div class="wrap">
    <div class="team">
      <header class="team__copy">
        <p class="eyebrow">How it works</p>
        <h2 id="process-title" class="display-l" data-reveal>One team, start to finish.</h2>
        <p class="lede">Every project is scoped, supplied and installed by our own team. No subcontracted crews.</p>
      </header>
      <figure class="team__photo" data-reveal>
        <img src="/assets/img/work/install-team.webp" alt="The PrimeTurf installation team standing on a newly installed turf court" width="1100" height="825" loading="lazy" decoding="async">
        <figcaption>The PrimeTurf installation team</figcaption>
      </figure>
    </div>
    <ol class="process">
      <li class="process__step" data-reveal><span class="label">Step 1</span><h3>Free quote request</h3><p>Call, WhatsApp or send the form. We respond within 2 hours.</p></li>
      <li class="process__step" data-reveal><span class="label">Step 2</span><h3>Site visit</h3><p>We measure and assess the site. Same-day visits available across Gauteng.</p></li>
      <li class="process__step" data-reveal><span class="label">Step 3</span><h3>Scope &amp; quote</h3><p>A clear written scope: turf, preparation, drainage and edging.</p></li>
      <li class="process__step" data-reveal><span class="label">Step 4</span><h3>Installation</h3><p>Supplied and installed by our own team — no subcontracted crews.</p></li>
      <li class="process__step" data-reveal><span class="label">Step 5</span><h3>Handover</h3><p>6-year product warranty and 24-month workmanship guarantee.</p></li>
    </ol>
  </div>
</section>

{# ───────────────────────── 8. COMMERCIAL / PARTNERS ───────────────────────── #}
<section class="section section--ink partners" id="partners" aria-labelledby="partners-title">
  <div class="wrap partners__inner">
    <div>
      <p class="eyebrow eyebrow--gold">Tenders, estates &amp; partners</p>
      <h2 id="partners-title" class="display-l" data-reveal>A single accountable contractor.</h2>
      <p class="lede">For property managers, developers, landscape architects and HOAs: we scope, supply and install with our own team across Gauteng and the Western Cape, with written warranties on product and workmanship.</p>
      <div class="hero__ctas">
        <a class="btn btn--gold" href="mailto:{{ site.contact.email }}?subject={{ 'Tender / partnership enquiry' | urlencode }}">Discuss a tender or partnership</a>
        <a class="btn btn--ghost-light" href="/services/commercial-properties/">Commercial services</a>
      </div>
    </div>
    <ul class="partners__list">
      <li><span class="label">Scope</span>Site assessment and written scope per phase</li>
      <li><span class="label">Supply</span>Turf supplied directly — one line of accountability</li>
      <li><span class="label">Install</span>Own installation team, scheduled around operations</li>
      <li><span class="label">Cover</span>6-year product warranty · 24-month workmanship guarantee</li>
      <li><span class="label">Reach</span>Gauteng and the Western Cape</li>
    </ul>
  </div>
</section>

{# ───────────────────────── 9. AREAS ───────────────────────── #}
<section class="section" id="areas" aria-labelledby="areas-title">
  <div class="wrap">
    <header class="section-head section-head--split">
      <div>
        <p class="eyebrow">Where we work</p>
        <h2 id="areas-title" class="display-l" data-reveal>Gauteng and the Western Cape.</h2>
      </div>
      <p class="section-head__aside">{{ site.promises.siteVisit }}.</p>
    </header>
    <ul class="area-grid">
      {% for l in locations %}
      <li data-reveal><a class="area-card" href="/areas/{{ l.slug }}/">
        <span class="area-card__name">{{ l.name }}</span>
        <span class="area-card__meta label">{{ l.region }}</span>
        <span class="area-card__arrow" aria-hidden="true">→</span>
      </a></li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ───────────────────────── 10. FAQ ───────────────────────── #}
<section class="section section--tint" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq">
    <header>
      <p class="eyebrow">Questions</p>
      <h2 id="faq-title" class="display-l">Asked often.</h2>
    </header>
    <div class="faq__list">
      {% for f in faq %}
      <details class="faq__item"{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}<span class="faq__icon" aria-hidden="true"></span></summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{# ───────────────────────── 11. QUOTE ───────────────────────── #}
<section class="section" id="quote" aria-labelledby="quote-title">
  <div class="wrap quote">
    <div class="quote__intro">
      <p class="eyebrow">Free quote</p>
      <h2 id="quote-title" class="display-l" data-reveal>Start with a conversation.</h2>
      <p class="lede">{{ site.promises.quote }}. {{ site.promises.response }}. {{ site.promises.siteVisit }}.</p>
      <ul class="contact-cards">
        <li><a class="contact-card" href="tel:{{ site.contact.phoneE164 }}"><span class="label">Call {{ site.contact.person }}</span><strong>{{ site.contact.phoneDisplay }}</strong></a></li>
        <li><a class="contact-card" href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener"><span class="label">WhatsApp</span><strong>{{ site.contact.phoneDisplay }}</strong></a></li>
        <li><a class="contact-card" href="mailto:{{ site.contact.email }}"><span class="label">Email</span><strong>{{ site.contact.email }}</strong></a></li>
      </ul>
    </div>
    <div class="quote__form">
      {% include "partials/quote-form.njk" %}
    </div>
  </div>
</section>
